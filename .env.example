# ============================================================================
# goMultiAgentV2 环境变量样例
# 复制为 .env 后按需修改；docker compose 会自动读取本文件。
# 注意：.env 含密钥，已被 .gitignore 忽略，切勿提交真实值。
# ============================================================================

# ---------- Server (server/internal/config) ----------
# HTTP 监听端口（容器内固定 8080，docker-compose 映射宿主机端口）
PORT=8080

# JWT 签名密钥（生产必须设为随机值：openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-string

# AES-256-GCM 主密钥（加密 Provider/MCP 敏感字段）；建议独立于 JWT_SECRET
PROVIDER_ENC_KEY=change-me-to-another-long-random-string

# SQLite 数据库路径（容器内默认 /data/codeagent.db，挂载卷持久化）
DB_PATH=/data/codeagent.db

# 用户代码执行根目录 / 工作状态外置根目录 / 私有技能目录
WORKSPACE_ROOT=/data/workspaces
ARTIFACT_ROOT=/data/agent-state
SKILLS_DATA_DIR=/data/skills

# 运行时模式：unattended（24h 自主平台安全默认）/ attended（有人值守调试）
RUN_MODE=unattended

# ---------- 代码执行后端（M8-02）----------
# host（默认）：宿主机受限工作目录执行（cwd 约束 + 危险命令策略 + 超时）
# docker：一次性容器沙箱——--network none（无网络）+ --read-only（只读根）+
#         工作目录挂载 /workspace，逃逸命令（写系统目录/出网/读宿主文件）在容器内被拒。
#         需宿主机安装 docker CLI；容器镜像需包含 Agent 所需工具链（git 工具要镜像内置 git）。
EXECUTOR_BACKEND=host
DOCKER_IMAGE=alpine:3.20      # 执行命令的容器镜像（需含 sh；git 工具需镜像内置 git）
DOCKER_NETWORK=none           # 容器网络白名单：none=无网络（最严）；bridge/host 可放行
DOCKER_READ_ONLY=true         # 只读根文件系统（写系统目录被拒）；false 可关（一般不推荐）
DOCKER_BIN=docker             # docker CLI 路径（默认按 PATH 查找）
DOCKER_TIMEOUT_SECONDS=60     # 单次容器命令执行超时

# ---------- taskrun 运行后端（M8-03）----------
# inprocess（默认）：单进程执行后台任务（框架 inprocess.Service，行为同旧版）
# queue：多节点外部队列——run 记录外置到共享 SQLite（同一 DB 文件），任务经原子领取
#       恰好被一个节点执行；节点崩溃后任务在 lease 过期时被其他节点重拾。
#       多副本部署时各副本设相同 TASKRUN_BACKEND=queue 并共享同一 DB 存储即可。
TASKRUN_BACKEND=inprocess
TASKRUN_QUEUE_POLL_INTERVAL_MS=1000   # poller 轮询间隔（取消/重拾灵敏度）
TASKRUN_QUEUE_LEASE_SECONDS=30        # 单次领取租约时长（长任务执行中自动续约）
TASKRUN_QUEUE_MAX_ATTEMPTS=3          # 节点崩溃重拾上限（超过后任务置 failed）

# Agent 编排（single / team）
AGENT_MODE=single
TEAM_REVIEWER=true
TEAM_MAX_REVIEW_ROUNDS=2
GOAL_CONTRACT=true
GOAL_MAX_NUDGES=3
PLAN_EXECUTE=true
PLAN_MAX_NUDGES=3

# 护栏熔断预算（GUARDRAIL_DISABLED 仅本地调试）
MAX_LLM_CALLS=32
MAX_TOOL_ITERATIONS=16
MAX_TOOL_RETRIES=2
GUARDRAIL_DISABLED=false

# 生态开关
SKILLS_ROOT=/app/skills
SKILL_WARM_START=true
SKILL_WARM_START_MAX_CHARS=6000
WORKTREE_ISOLATION=true
TOOL_SEARCH_ENABLED=true
KNOWLEDGE_ENABLED=true
# 知识库向量库后端（M8-04）：sqlite（默认，本地基线，零外部依赖）| pgvector
#（PostgreSQL + pgvector 扩展，万级 chunk 检索 P99 达标、并发无退化，生产推荐）。
# pgvector 模式必须配置 KB_PG_DSN（缺失则启动失败，杜绝静默回落 sqlite）。
# 部署说明见 docs/knowledge-pgvector.md。
KB_STORE=sqlite
#KB_PG_DSN=postgres://codeagent:password@localhost:5432/codeagent
#KB_PG_DIM=256          # 向量维度，须与嵌入器一致（内置本地嵌入器为 256）
#KB_PG_POOL=10          # 连接池大小（并发检索支撑）

# 企业化开关
STATE_ENABLED=true
BUDGET_ENABLED=true
CHECKPOINT_ENABLED=true
DB_AUTO_MIGRATE=false
METRICS_ENABLED=true

# 自主化
WEBHOOK_RATE_LIMIT=10
WEBHOOK_RATE_WINDOW_SECONDS=60
RECOVERY_MAX_ATTEMPTS=3
WEBHOOK_NOTIFY_URL=
EVOLUTION_ENABLED=true
EVOLUTION_INTERVAL_SECONDS=3600

# 安全加固（MX-07）
CORS_ALLOWED_ORIGINS=http://localhost:8081
RATE_LIMIT_LOGIN_ENABLED=true
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_ENABLED=true
RATE_LIMIT_CHAT_LIMIT=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60

# ---------- 可观测性（M7-04 告警 / M7-06 日志聚合） ----------
# 结构化日志（obslog）：json=生产友好（可被 Loki/ELK 集中采集）/ text=本地调试
LOG_FORMAT=json
LOG_LEVEL=info              # debug / info / warn / error

# 告警接收端点共享密钥：Alertmanager webhook → /api/alerts 的 Bearer token。
# 生产建议开启（openssl rand -hex 32），且 monitoring/alertmanager.yml 中必须填同一令牌（见 docs/DEPLOYMENT.md §3.3）。
ALERT_WEBHOOK_TOKEN=
# 告警通知目标管理员用户 ID（逗号分隔，默认 1；空则默认 1）
ALERT_NOTIFY_USER_IDS=1

# ---------- IM Channel（M8-07：飞书/钉钉/企微，见 docs/im-channel.md）----------
# 三平台「自定义机器人出站 webhook URL」：非空才注册该平台的回发能力（Loop 结果回发 IM）。
# 三平台「入站事件验签密钥」：非空才启用签名校验（生产必须配置；空=本地调试跳过验签，勿用于生产）。
IM_FEISHU_WEBHOOK_URL=
IM_FEISHU_SECRET=
IM_DINGTALK_WEBHOOK_URL=
IM_DINGTALK_SECRET=
IM_WECOM_WEBHOOK_URL=
IM_WECOM_SECRET=

# ---------- Gateway (tool/workbuddyLLMAPI) ----------
# 容器内监听地址（docker-compose 映射宿主机 8088）
WB_LISTEN=:8088

# 后端选择：passthrough（服务器部署，对接外部 LLM）| mock（本地回显）| codebuddy（需本机 WorkBuddy 桌面，无法进容器）
WB_BACKEND=passthrough

# passthrough 上游 OpenAI 兼容端点与密钥
WB_BASE_URL=https://api.openai.com/v1
WB_API_KEY=

# codebuddy 后端相关（仅本机宿主机运行网关时有效；容器内留默认值即可）
WB_DAEMON_URL=http://127.0.0.1:18765
WB_DAEMON_CWD=/
WB_DAEMON_MODEL=hy3
WB_DAEMON_FALLBACK_MODEL=deepseek-v4-pro
WB_DEFAULT_MODEL=codebuddy-default

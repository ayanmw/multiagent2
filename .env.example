# ============================================================================
# goMultiAgentV2 环境变量样例
# 复制为 .env 后按需修改；docker compose 会自动读取本文件。
# 注意：.env 含密钥，已被 .gitignore 忽略，切勿提交真实值。
# ============================================================================

# ---------- Server (server/internal/config) ----------
# HTTP 监听端口（容器内固定 8080，docker-compose 映射宿主机端口）
PORT=8080

# JWT 签名密钥（生产必须设为随机值：openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-string

# AES-256-GCM 主密钥（加密 Provider/MCP 敏感字段）；建议独立于 JWT_SECRET
PROVIDER_ENC_KEY=change-me-to-another-long-random-string

# SQLite 数据库路径（容器内默认 /data/codeagent.db，挂载卷持久化）
DB_PATH=/data/codeagent.db

# 用户代码执行根目录 / 工作状态外置根目录 / 私有技能目录
WORKSPACE_ROOT=/data/workspaces
ARTIFACT_ROOT=/data/agent-state
SKILLS_DATA_DIR=/data/skills

# 运行时模式：unattended（24h 自主平台安全默认）/ attended（有人值守调试）
RUN_MODE=unattended

# Agent 编排（single / team）
AGENT_MODE=single
TEAM_REVIEWER=true
TEAM_MAX_REVIEW_ROUNDS=2
GOAL_CONTRACT=true
GOAL_MAX_NUDGES=3
PLAN_EXECUTE=true
PLAN_MAX_NUDGES=3

# 护栏熔断预算（GUARDRAIL_DISABLED 仅本地调试）
MAX_LLM_CALLS=32
MAX_TOOL_ITERATIONS=16
MAX_TOOL_RETRIES=2
GUARDRAIL_DISABLED=false

# 生态开关
SKILLS_ROOT=/app/skills
SKILL_WARM_START=true
SKILL_WARM_START_MAX_CHARS=6000
WORKTREE_ISOLATION=true
TOOL_SEARCH_ENABLED=true
KNOWLEDGE_ENABLED=true

# 企业化开关
STATE_ENABLED=true
BUDGET_ENABLED=true
CHECKPOINT_ENABLED=true
DB_AUTO_MIGRATE=false
METRICS_ENABLED=true

# 自主化
WEBHOOK_RATE_LIMIT=10
WEBHOOK_RATE_WINDOW_SECONDS=60
RECOVERY_MAX_ATTEMPTS=3
WEBHOOK_NOTIFY_URL=
EVOLUTION_ENABLED=true
EVOLUTION_INTERVAL_SECONDS=3600

# 安全加固（MX-07）
CORS_ALLOWED_ORIGINS=http://localhost:8081
RATE_LIMIT_LOGIN_ENABLED=true
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_ENABLED=true
RATE_LIMIT_CHAT_LIMIT=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60

# ---------- 可观测性（M7-04 告警 / M7-06 日志聚合） ----------
# 结构化日志（obslog）：json=生产友好（可被 Loki/ELK 集中采集）/ text=本地调试
LOG_FORMAT=json
LOG_LEVEL=info              # debug / info / warn / error

# 告警接收端点共享密钥：Alertmanager webhook → /api/alerts 的 Bearer token。
# 生产建议开启（openssl rand -hex 32），且 monitoring/alertmanager.yml 中必须填同一令牌（见 docs/DEPLOYMENT.md §3.3）。
ALERT_WEBHOOK_TOKEN=
# 告警通知目标管理员用户 ID（逗号分隔，默认 1；空则默认 1）
ALERT_NOTIFY_USER_IDS=1

# ---------- Gateway (tool/workbuddyLLMAPI) ----------
# 容器内监听地址（docker-compose 映射宿主机 8088）
WB_LISTEN=:8088

# 后端选择：passthrough（服务器部署，对接外部 LLM）| mock（本地回显）| codebuddy（需本机 WorkBuddy 桌面，无法进容器）
WB_BACKEND=passthrough

# passthrough 上游 OpenAI 兼容端点与密钥
WB_BASE_URL=https://api.openai.com/v1
WB_API_KEY=

# codebuddy 后端相关（仅本机宿主机运行网关时有效；容器内留默认值即可）
WB_DAEMON_URL=http://127.0.0.1:18765
WB_DAEMON_CWD=/
WB_DAEMON_MODEL=hy3
WB_DAEMON_FALLBACK_MODEL=deepseek-v4-pro
WB_DEFAULT_MODEL=codebuddy-default
